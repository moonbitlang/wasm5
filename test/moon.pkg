import {
  "moonbitlang/async/fs",
  "moonbitlang/async/io",
  "moonbitlang/async/process",
  "moonbitlang/async",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/test" @mbtest,
  "moonbitlang/core/string",
  "moonbitlang/core/debug",
  "moonbitlang/wasm5/internal/runtime" @wasm5_runtime,
  "moonbitlang/wasm5/internal/cruntime" @wasm5_cruntime,
  "moonbitlang/wasm5/internal/core" @wasm5_core,
  "moonbitlang/wasm5/internal/parse" @wasm5_parse,
  "moonbitlang/wasm5/internal/validate" @wasm5_validate,
}

options(
  "pre-build": [
    {
      "input": [ "test_manifest.json", "../scripts/generate_tests.py" ],
      "output": [ "reference_test.mbt" ],
      "command": "python3 scripts/generate_tests.py > $output",
    },
  ],
)
